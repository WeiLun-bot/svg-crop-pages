# Register a GitHub App with Contents: read and write, installed on the two target repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public production origin of the login/upload backend. No trailing slash.
BACKEND_ORIGIN=https://svg-crop-pages.vercel.app
FRONTEND_URL=https://weilun-bot.github.io/svg-crop-pages/
# Optional: override server/targets.mjs when repository folders are consolidated.
